{
  "datasets": [
    {
      "name": "sales",
      "displayName": "Sales metrics (t_sales_metrics)",
      "asset_name": "mdk_demo_catalog.t_hardware.t_sales_metrics"
    },
    {
      "name": "inventory",
      "displayName": "Inventory position",
      "config": {
        "version": "1.1",
        "source": "mdk_demo_catalog.t_hardware.gold_inventory_position",
        "dimensions": [
          {
            "expr": "warehouse"
          },
          {
            "expr": "category"
          },
          {
            "expr": "stock_status"
          }
        ],
        "measures": [
          {
            "name": "inventory_value",
            "expr": "SUM(inventory_value_cad)",
            "format": {
              "type": "currency",
              "currencyCode": "CAD",
              "abbreviation": "compact",
              "decimalPlaces": {
                "type": "max",
                "places": 1.0
              }
            }
          },
          {
            "name": "skus_below_reorder",
            "expr": "COUNT(1) FILTER (WHERE below_reorder_point)"
          },
          {
            "name": "sku_count",
            "expr": "COUNT(1)"
          }
        ]
      }
    },
    {
      "name": "price_gap",
      "displayName": "Competitor price gap",
      "config": {
        "version": "1.1",
        "source": "mdk_demo_catalog.t_hardware.gold_price_benchmark_by_competitor",
        "dimensions": [
          {
            "expr": "category"
          },
          {
            "expr": "competitor_name"
          }
        ],
        "measures": [
          {
            "name": "avg_pct_gap",
            "expr": "AVG(pct_gap)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "tickets",
      "displayName": "HubSpot ticket insights",
      "config": {
        "version": "1.1",
        "source": "mdk_demo_catalog.t_hardware.gold_ticket_insights",
        "dimensions": [
          {
            "expr": "theme"
          },
          {
            "expr": "created_date"
          },
          {
            "expr": "region"
          },
          {
            "expr": "warehouse"
          },
          {
            "expr": "category"
          }
        ],
        "measures": [
          {
            "name": "tickets",
            "expr": "COUNT(1)"
          },
          {
            "name": "open_tickets",
            "expr": "COUNT(1) FILTER (WHERE is_open)"
          }
        ]
      }
    },
    {
      "name": "overpriced",
      "displayName": "SKUs >10% above cheapest competitor",
      "queryLines": [
        "SELECT sku, product_name, category, t_list_price_cad, competitor_min_price_cad, cheapest_competitor, pct_gap_vs_min\n",
        "FROM mdk_demo_catalog.t_hardware.gold_price_benchmark\n",
        "WHERE pct_gap_vs_min > 0.10\n",
        "ORDER BY pct_gap_vs_min DESC"
      ]
    }
  ],
