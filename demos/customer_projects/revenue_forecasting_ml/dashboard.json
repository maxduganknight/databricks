            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_actual_vs_forecast_bars",
                  "fields": [
                    { "name": "week_start", "expression": "`week_start`" },
                    { "name": "revenue", "expression": "`revenue`" },
                    { "name": "series", "expression": "`series`" }
                  ],
                  "disaggregated": true
                }
              }
