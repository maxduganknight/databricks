                  "displayName": "Weekly Revenue ($)"
                },
                "color": {
                  "fieldName": "series",
                  "scale": {
                    "type": "categorical",
                    "mappings": [
                      { "value": "Actual", "color": "#8BCAE7" },
                      { "value": "Predicted", "color": "#FFAB00" }
                    ]
                  },
                  "displayName": "Series"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Model Validation: Actual vs Predicted Weekly Revenue (Last 12 Months)"
              }
            }
          },
          "position": { "x": 0, "y": 11, "width": 6, "height": 5 }
        },
        {
          "widget": {
            "name": "w_feature_importance",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_feature_importance",
                  "fields": [
                    { "name": "feature", "expression": "`feature`" },
