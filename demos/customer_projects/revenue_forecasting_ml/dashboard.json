          "position": { "x": 3, "y": 7, "width": 3, "height": 5 }
        },
        {
          "widget": {
            "name": "w_weekly_validation",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_weekly_validation",
                  "fields": [
